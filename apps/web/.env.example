# Copy to apps/web/.env (gitignored) for local dev. Set the same keys in your host's
# environment for staging/production. Nothing here except VITE_* reaches the browser.

# --- Gifts storage (PRP-001) ------------------------------------------------
# "sheets" (default) uses the Google Sheets API. "memory" is an in-process fake
# for local UI work without credentials (refused when NODE_ENV=production).
GIFTS_BACKEND=sheets
# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service-account key: raw JSON on one line, or base64 of the JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the above for local dev: path to the downloaded key file.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional. Lets releaseGift({ adminKey }) clear all reservations on a gift.
ADMIN_KEY=

# Public origin of the app (used for Secure cookies, auth callbacks, CSRF).
BASE_URL=http://localhost:3000
