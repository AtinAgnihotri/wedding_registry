# Copy to .env (never commit .env). Everything here is server-only unless prefixed VITE_.
# VITE_* values are inlined into the browser bundle — only public keys go there.

# --- Base URL -----------------------------------------------------------------
# Public origin of this deployment (used for OAuth callbacks, cookies, trusted origin).
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Gifts storage (PRP-001) ----------------------------------------------------
# `sheets` (default) or `memory` (local dev/tests only; refused in production, resets on restart).
GIFTS_BACKEND=sheets
# The ID from https://docs.google.com/spreadsheets/d/<ID>/edit. Share the Sheet with the
# service account's client_email as Editor. A "Gifts" tab is created if missing.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account key: raw JSON (single line) or base64 of the JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the above for local dev: path to the key file (keep it outside the repo).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional. Lets the couple clear every reservation on a gift via releaseGift({ adminKey }).
ADMIN_KEY=

# --- Auth (PRP-002, optional: guests never need to log in) ---------------------
# Login is disabled (registry still works) when DATABASE_URL or BETTER_AUTH_SECRET is empty.
# Neon pooled connection string, e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth (provider is hidden until both are set).
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login (provider is hidden until both are set).
# Valid OAuth Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# MSG91 phone OTP (+91). Template must be DLT-approved and contain the ##OTP## variable.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Local dev only: when MSG91 keys are empty, print OTPs to the server console instead.
MSG91_DEV_LOG_OTP=false

# --- Bot protection --------------------------------------------------------------
# Cloudflare Turnstile. Verified on reserveGift, addGift and OTP send.
# In production a missing secret blocks those calls (fail closed); locally it is skipped.
# Test keys: site 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA (always pass),
#            secret 2x0000000000000000000000000000000AA (always fail).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Header carrying the real client IP that your host sets and clients cannot spoof
# (cf-connecting-ip behind Cloudflare; x-forwarded-for on Vercel/Netlify/Fly). Used for rate limits.
TRUSTED_IP_HEADER=x-forwarded-for
